# Same database as the customer API (kiran_book_center_config).
DB_SERVER=localhost
DB_DATABASE=KiranBookCenter
DB_USER=
# Put the password in double quotes if it contains # (dotenv treats # as a comment).
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=false

# Owner sessions: a long random secret (at least 32 characters), different from the customer API's.
ADMIN_AUTH_SECRET=
ADMIN_TOKEN_TTL_SECONDS=43200

# Uploaded files: "db" keeps them in dbo.FileBlobs (hosts without a lasting disk); otherwise ./uploads.
FILE_STORE=
UPLOAD_DIR=

# Comma-separated web addresses allowed to call this API (the admin web app). Empty = any (local only).
CORS_ORIGINS=
PORT=5101
